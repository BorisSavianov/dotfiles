#!/bin/sh
set -u

if ! command -v lxqt-policykit-agent >/dev/null 2>&1; then
    exit 0
fi

if [ -z "${WAYLAND_DISPLAY:-}" ] && [ -z "${DISPLAY:-}" ]; then
    exit 0
fi

lock="${XDG_RUNTIME_DIR:-/tmp}/polkit-agent-start.lock"
exec 9>"$lock"
/usr/bin/flock -n 9 || exit 0

export GTK_THEME="${GTK_THEME:-Adwaita:dark}"
export QT_STYLE_OVERRIDE="${QT_STYLE_OVERRIDE:-Fusion}"

stylesheet="${XDG_CONFIG_HOME:-$HOME/.config}/lxqt/polkit-agent.qss"

while :; do
    if [ -r "$stylesheet" ]; then
        lxqt-policykit-agent -stylesheet "$stylesheet"
    else
        lxqt-policykit-agent
    fi
    sleep 1
done
