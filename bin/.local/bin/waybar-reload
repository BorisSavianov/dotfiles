#!/bin/sh
set -eu

if command -v waybar >/dev/null 2>&1; then
    waybar_bin="$(command -v waybar)"
elif [ -x /usr/sbin/waybar ]; then
    waybar_bin="/usr/sbin/waybar"
else
    printf 'waybar not found\n' >&2
    exit 1
fi

/usr/bin/pkill -x waybar 2>/dev/null || true
/usr/bin/sleep 0.2
exec "$waybar_bin"
