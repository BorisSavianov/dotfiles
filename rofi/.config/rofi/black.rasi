* {
  bg: #07080af7;
  bg-soft: #0d0f13f7;
  bg-field: #11141afa;
  bg-hover: #171c24fa;
  bg-active: #1d2430fa;
  fg: #e8ebf0;
  fg-normal: #aeb5c0;
  fg-muted: #727b88;
  fg-soft: #cfd5de;
  accent: #8fb7ff;
  accent-soft: #223049;
  urgent: #f0a6b8;
  border: #222832f2;
  border-muted: #ffffff10;
  border-strong: #5f84bd;

  font: "Adwaita Sans 10";
}

window {
  width: 440px;
  max-width: 440px;
  location: center;
  anchor: center;
  border: 1px;
  border-color: @border;
  border-radius: 8px;
  background-color: @bg;
}

mainbox {
  spacing: 10px;
  padding: 12px;
  background-color: transparent;
}

inputbar {
  spacing: 8px;
  padding: 9px 11px;
  border: 1px;
  border-color: @border;
  border-radius: 7px;
  background-color: @bg-field;
  children: [prompt, entry, case-indicator];
}

prompt {
  expand: false;
  padding: 0;
  background-color: transparent;
  text-color: @accent;
  vertical-align: 0.5;
}

entry {
  placeholder: "Search";
  placeholder-color: @fg-muted;
  background-color: transparent;
  text-color: @fg-soft;
  cursor-color: @accent;
  cursor-width: 2px;
  hide-cursor-on-empty: true;
}

case-indicator {
  expand: false;
  background-color: transparent;
  text-color: @fg-muted;
  vertical-align: 0.5;
}

listview {
  lines: 9;
  columns: 1;
  fixed-height: true;
  fixed-columns: true;
  scrollbar: false;
  spacing: 5px;
  padding: 0;
  background-color: transparent;
}

element {
  orientation: horizontal;
  children: [element-icon, element-text];
  spacing: 10px;
  padding: 8px 11px;
  border: 1px;
  border-color: transparent;
  border-radius: 7px;
  background-color: transparent;
  text-color: @fg-normal;
  cursor: pointer;
}

element normal.normal {
  background-color: transparent;
  text-color: @fg-normal;
}

element alternate.normal {
  background-color: transparent;
  text-color: @fg-normal;
}

element normal.active,
element alternate.active {
  background-color: @accent-soft;
  border-color: @border-muted;
  text-color: @fg-soft;
}

element normal.urgent,
element alternate.urgent {
  background-color: @bg-active;
  border-color: @border;
  text-color: @urgent;
}

element selected.normal {
  background-color: @bg-hover;
  border-color: @border-strong;
  text-color: @fg;
}

element selected.active,
element selected.urgent {
  background-color: @bg-active;
  border-color: @border-strong;
  text-color: @fg;
}

element-icon {
  size: 18px;
  padding: 0;
  background-color: transparent;
  vertical-align: 0.5;
}

element-text {
  background-color: transparent;
  text-color: inherit;
  vertical-align: 0.5;
}

message {
  border: 1px;
  border-color: @border-muted;
  border-radius: 7px;
  background-color: @bg-soft;
  padding: 8px 10px;
}

textbox {
  background-color: transparent;
  text-color: @fg-muted;
}

error-message {
  border: 1px;
  border-color: @border-strong;
  border-radius: 7px;
  background-color: @bg-soft;
  padding: 10px;
}

mode-switcher {
  spacing: 4px;
}

button {
  padding: 6px 9px;
  border: 1px;
  border-color: transparent;
  border-radius: 6px;
  background-color: transparent;
  text-color: @fg-muted;
  cursor: pointer;
}

button selected {
  background-color: @bg-hover;
  border-color: @border-strong;
  text-color: @fg;
}
