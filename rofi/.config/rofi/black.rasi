* {
  bg: #050607f5;
  surface: #0c0e11f0;
  surface-raised: #111418f5;
  surface-hover: #181d23f5;
  surface-active: #10211ff2;
  fg: #edf2f4;
  fg-normal: #bec7cc;
  fg-muted: #8f989f;
  fg-soft: #d8e0e3;
  accent: #66d9c8;
  accent-soft: #66d9c824;
  warning: #e0b75b;
  danger: #ff6b6b;
  border: #ffffff14;
  border-muted: #ffffff0d;
  border-strong: #66d9c89e;

  font: "Adwaita Sans 10";
}

window {
  width: 470px;
  max-width: 470px;
  location: center;
  anchor: center;
  border: 1px;
  border-color: @border;
  border-radius: 8px;
  background-color: @bg;
}

mainbox {
  spacing: 9px;
  padding: 12px;
  background-color: transparent;
}

inputbar {
  spacing: 8px;
  padding: 10px 12px;
  border: 1px;
  border-color: @border;
  border-radius: 7px;
  background-color: @surface-raised;
  children: [prompt, entry, case-indicator];
}

prompt {
  expand: false;
  padding: 0;
  background-color: transparent;
  text-color: @accent;
  vertical-align: 0.5;
}

entry {
  placeholder: "Search";
  placeholder-color: @fg-muted;
  background-color: transparent;
  text-color: @fg;
  cursor-color: @accent;
  cursor-width: 2px;
  hide-cursor-on-empty: true;
}

case-indicator {
  expand: false;
  background-color: transparent;
  text-color: @fg-muted;
  vertical-align: 0.5;
}

listview {
  lines: 9;
  columns: 1;
  fixed-height: true;
  fixed-columns: true;
  scrollbar: false;
  spacing: 4px;
  padding: 0;
  background-color: transparent;
}

element {
  orientation: horizontal;
  children: [element-icon, element-text];
  spacing: 9px;
  padding: 8px 10px;
  border: 1px;
  border-color: transparent;
  border-radius: 7px;
  background-color: transparent;
  text-color: @fg-normal;
  cursor: pointer;
}

element normal.normal {
  background-color: transparent;
  text-color: @fg-normal;
}

element alternate.normal {
  background-color: transparent;
  text-color: @fg-normal;
}

element normal.active,
element alternate.active {
  background-color: @surface-active;
  border-color: @border-muted;
  text-color: @fg-soft;
}

element normal.urgent,
element alternate.urgent {
  background-color: #ff6b6b1f;
  border-color: #ff6b6b4d;
  text-color: @danger;
}

element selected.normal {
  background-color: @accent-soft;
  border-color: @border-strong;
  text-color: @fg;
}

element selected.active,
element selected.urgent {
  background-color: @surface-active;
  border-color: @border-strong;
  text-color: @fg;
}

element-icon {
  size: 16px;
  padding: 0;
  background-color: transparent;
  vertical-align: 0.5;
}

element-text {
  background-color: transparent;
  text-color: inherit;
  vertical-align: 0.5;
}

message {
  border: 1px;
  border-color: @border-muted;
  border-radius: 7px;
  background-color: @surface;
  padding: 8px 10px;
}

textbox {
  background-color: transparent;
  text-color: @fg-muted;
}

error-message {
  border: 1px;
  border-color: @border-strong;
  border-radius: 7px;
  background-color: @surface;
  padding: 10px;
}

mode-switcher {
  spacing: 4px;
}

button {
  padding: 6px 9px;
  border: 1px;
  border-color: transparent;
  border-radius: 6px;
  background-color: transparent;
  text-color: @fg-muted;
  cursor: pointer;
}

button selected {
  background-color: @accent-soft;
  border-color: @border-strong;
  text-color: @fg;
}
