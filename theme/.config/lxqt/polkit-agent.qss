QWidget {
    background-color: #000000;
    color: #f5f5f5;
    selection-background-color: #f5f5f5;
    selection-color: #000000;
}

QDialog {
    background-color: #000000;
}

QLabel {
    color: #f5f5f5;
}

QLineEdit,
QComboBox {
    background-color: #080808;
    color: #f5f5f5;
    border: 1px solid #333333;
    border-radius: 4px;
    padding: 6px 8px;
}

QLineEdit:focus,
QComboBox:focus {
    border-color: #f5f5f5;
}

QComboBox::drop-down {
    border: 0;
    width: 22px;
}

QComboBox QAbstractItemView {
    background-color: #000000;
    color: #f5f5f5;
    border: 1px solid #333333;
    selection-background-color: #f5f5f5;
    selection-color: #000000;
}

QPushButton {
    background-color: #111111;
    color: #f5f5f5;
    border: 1px solid #333333;
    border-radius: 4px;
    padding: 7px 14px;
}

QPushButton:hover {
    background-color: #1a1a1a;
    border-color: #666666;
}

QPushButton:focus,
QPushButton:default {
    border-color: #f5f5f5;
}

QPushButton:pressed {
    background-color: #f5f5f5;
    color: #000000;
}

QPushButton:disabled,
QLineEdit:disabled,
QComboBox:disabled {
    background-color: #080808;
    color: #777777;
    border-color: #222222;
}
